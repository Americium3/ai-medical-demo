# Vercel AI Gateway key, used by /api/chat, /api/score and the simulated patient on /agent.
AI_GATEWAY_API_KEY=

# The consultation backend that /agent talks to (backend/, run with `npm run backend:server`).
# The key is one of the backend's API_KEYS; it stays on the server.
BACKEND_URL=
BACKEND_API_KEY=

# Set to 1 to make the /agent demo's simulated patient use the scripted (offline) answers.
AGENT_MOCK=

# Per-IP limit on /api/agent and /api/agent/patient, requests per minute. Empty or 0 = off.
AGENT_RATE_LIMIT_PER_MINUTE=

# Langfuse node-level tracing (backend). Off unless all three are set.
# Prefer a self-hosted Langfuse: patient text is sensitive. See backend/README.md.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Phone and ID numbers are always masked. For a base URL that is not localhost or a
# private address, ALL text is masked unless you confirm it is self-hosted here.
LANGFUSE_SELF_HOSTED=
