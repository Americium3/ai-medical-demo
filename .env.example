# Vercel AI Gateway key, used by /api/chat, /api/score and the agent.
AI_GATEWAY_API_KEY=

# Set to 1 to run the agent pages and APIs with the offline deterministic mock (no key needed).
AGENT_MOCK=

# Langfuse node-level tracing (backend and /api/agent). Off unless all three are set.
# Prefer a self-hosted Langfuse: patient text is sensitive. See backend/README.md.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Phone and ID numbers are always masked. For a base URL that is not localhost or a
# private address, ALL text is masked unless you confirm it is self-hosted here.
LANGFUSE_SELF_HOSTED=
